{
  "name": "@vestcodes/vcecom-backend",
  "version": "0.0.1",
  "description": "NestJS backend API for VCEcom ecommerce platform",
  "author": "Vestcodes <contact@vestcodes.co>",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/generate-build-info.js && nest build",
    "generate-build-info": "node scripts/generate-build-info.js",
    "dev": "nodemon",
    "start": "node dist/main.js",
    "start:dev": "nodemon",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "node scripts/generate-build-info.js && jest",
    "test:watch": "jest --watch",
    "test:cov": "node scripts/generate-build-info.js && jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "check-types": "cd ../../packages/db && pnpm build && cd ../../apps/backend && node scripts/generate-build-info.js && tsc --noEmit --project tsconfig.build.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.952.0",
    "@aws-sdk/s3-request-presigner": "^3.952.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^8.0.7",
    "@supabase/supabase-js": "^2.88.0",
    "@types/multer": "^2.0.0",
    "@types/pdfkit": "^0.17.4",
    "@vcecom/db": "workspace:*",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "fuse.js": "^7.1.0",
    "ioredis": "^5.4.1",
    "minio": "^8.0.6",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17.2",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "nestjs-pino": "^3.0.0",
    "pino": "^9.0.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/instrumentation": "^0.55.0",
    "@opentelemetry/instrumentation-http": "^0.55.0",
    "@opentelemetry/instrumentation-pg": "^0.55.0",
    "@opentelemetry/instrumentation-ioredis": "^0.56.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.55.0",
    "@opentelemetry/exporter-zipkin": "^1.25.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "@opentelemetry/resources": "^1.30.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^22.15.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "jest": "^30.0.0",
    "msw": "^2.12.3",
    "pino-pretty": "^11.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/test-utils/jest-setup.ts"
    ]
  }
}
