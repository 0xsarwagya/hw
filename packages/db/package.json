{
  "name": "@vcecom/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./dist/schema/index.js"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:ci": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:push:ci": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "db:migrate:run": "tsx src/migrate-cli.ts",
    "db:seed": "node dist/seed.js",
    "build": "tsc",
    "postbuild": "pnpm db:seed || true",
    "check-types": "tsc --noEmit --project tsconfig.json",
    "check-types:test": "tsc --noEmit --project tsconfig.test.json",
    "test": "echo 'Skipping DB tests' && exit 0",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@vcecom/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.10",
    "@vitest/ui": "^2.1.8",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.2",
    "typescript": "5.9.2",
    "vitest": "^2.1.8"
  }
}
